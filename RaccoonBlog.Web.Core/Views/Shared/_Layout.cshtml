@using RaccoonBlog.Web.Core.Models
@{
    var banners = new[]
    {
        new {ResourceUrl = "https://ravendb.net/ravendb-vs-mongodb?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/ravendb-vs-mongodb.jpg", AltText = "Comparison page for RavenDB and MongoDB"},
        new {ResourceUrl = "https://ravendb.net/?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/ravendb.jpg", AltText = "RavenDB - High-Performance NoSQL Document Database"},
        new {ResourceUrl = "https://ravendb.net/whitepapers/couchbase-vs-ravendb-performance-at-rakuten-kobo?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/couchbase-vs-ravendb-whitepaper.png", AltText = "Couchbase vs RavenDB Performance at Rakuten Kobo Whitepaper"},
        new {ResourceUrl = "https://ravendb.net/workshops?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/workshops-ravendb.png", AltText = "RavenDB Workshops - Deep dive into practical use of Document Data Modeling"},
        new {ResourceUrl = "https://ravendb.net/learn/webinars?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/webinars-ravendb.png", AltText = "Deep Dive into RavenDB webinars"},
        new {ResourceUrl = "https://ravendb.net/lp/ai-agent-creator?utm_source=ayende_blog&utm_medium=banner", ImageSrc = "Content/css/img/banners/ai-agent.jpg", AltText = "AI Agents, powered by your database - Bring AI into your applications with context, tools, and your data"},
    };

    var random = new Random();
    int index = random.Next(banners.Length);
    var bannerToDisplay = banners[index];
    
    var blogConfig = ViewBag.BlogConfig as BlogConfig;
    var message = TempData["Message"] as string;
    var searchTerm = ViewBag.SearchTerm as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="format-detection" content="telephone=no" />

    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="manifest" href="~/site.webmanifest">
    <link rel="mask-icon" href="~/safari-pinned-tab.svg" color="#388ee9">
    <meta name="msapplication-TileColor" content="#388ee9">
    <meta name="theme-color" content="#388ee9">

    @if (blogConfig?.MetaDescription != null)
    {
        <meta name="description" content="@blogConfig.MetaDescription">
    }
    
    @if (Context.Request.Query.ContainsKey("key"))
    {
        <meta name="robots" content="noindex" />
    }
    
    <title>
        @if (ViewBag.Title != null)
        {<text> @ViewBag.Title - </text>} @(blogConfig?.Title ?? "Raccoon Blog")
    </title>

    @await RenderSectionAsync("HeaderAdditions", false)
    
    <link rel="stylesheet" href="~/Content/css/styles.css" />
    
    @await RenderSectionAsync("Style", false)
</head>

<body class="show-grid">
    @{
        var containerClass = "body-container";
        // TODO: SidebarHelper
        /*
        if (SidebarHelper.ShouldShowSidebar() == false)
        {
            containerClass += " hideSidebar";
        }
        */
    }
    <div class="@containerClass">
        <div class="leftSide">
            <header>
                <a asp-controller="Posts" asp-action="List" class="logo">
                    <h1>Oren Eini</h1>
                    <span class="lead">aka Ayende Rahien</span>
                </a>
                <button class="menu-button" id="open-button"><i class="icon-arrow-down hide-sm" aria-hidden="true"></i></button>
            </header>
            
            <a asp-controller="Posts" asp-action="List" class="logo-vertical">
                <h1>Oren Eini</h1>
            </a>

            <button class="menu-enlarge" id="enlarge-button"><i class="icon-circle-arrow-left hide-sm" aria-hidden="true"></i></button>
            <div class="collapseMobile flex-grow">
                <div class="about flex-grow @(ViewBag.IsHomePage == true ? "home" : string.Empty)">
                    @await RenderSectionAsync("Contact Me", required: false)
                </div>
                <div class="flex-grow"></div>
                <div class="rewards margin-top">
                    <a class="mvp-profile-vertical" href="https://mvp.microsoft.com/en-us/PublicProfile/4012807" title="Microsoft MVP Reconnect Oren Eini" target="_blank" rel="nofollow"><img src="~/Content/css/img/mvp-vertical.svg" /></a>
                    <a class="dzone-profile-vertical" href="https://dzone.com/users/750579/ayende.html" title="DZone 2020 Hall of Fame Award Winner" target="_blank" rel="nofollow"><img src="~/Content/css/img/dzone-vertical.svg" /></a>
                </div>
                <div class="pull-down">
                    @await RenderSectionAsync("Stats", required: false)
                    <p class="copyright">Copyright ©️ Ayende Rahien 2004 — @DateTime.Now.Year.ToString()</p>
                    <small class="text-muted"><a asp-controller="PrivacyPolicy" asp-action="Index" class="legal-link">Privacy Policy</a></small>
                    <span class="separator margin-left-sm margin-right-sm">·</span>
                    <small class="text-muted"><a asp-controller="Terms" asp-action="Index" class="legal-link">Terms</a></small>
                </div>
            </div>
        </div>
        <div id="content" class="centerCol flex-grow">
            <header class="body-header">
                <div class="search">
                    <form asp-controller="Search" asp-action="SearchResult" method="get">
                        <input name="q" type="search" placeholder="search" class="form-control" value="@searchTerm" />
                        <input type="submit" value="Search" style="visibility: hidden; position: absolute;" />
                    </form>
                </div>
                <div style="display:inline-block">
                     </div>
                <nav class="pull-right views @(ViewBag.ChangeViewStyle == null ? "hide" : "")">
                    <a href="#" class="stackView" id="stackView">stack view</a>
                    <a href="#" class="gridView active" id="gridView">grid view</a>
                </nav>

                <div class="clearfix"></div>
                
                @await RenderSectionAsync("Tags", required: false)
                @await RenderSectionAsync("Archive", required: false)
            </header>
            
            <div class="bnr-carousel">
                <a href="@bannerToDisplay.ResourceUrl" target="_blank">
                    <img src="~/@bannerToDisplay.ImageSrc" class="img-responsive img-center" title="@bannerToDisplay.AltText" alt="@bannerToDisplay.AltText" />
                </a>
            </div>
            
            @RenderBody()
        </div>
        <section class="rightSide">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="alert alert-warning">TODO: Admin Panel</div>
            }
            
            <div class="sidebar-debug">
                <vc:tags-list-view></vc:tags-list-view>
                <vc:archives-list-view></vc:archives-list-view>
                <vc:posts-statistics-view></vc:posts-statistics-view>
            </div>

        </section>
    </div>

    @if (IsSectionDefined("Script"))
    {
        <script type="text/javascript">
            window.RaccoonRoutes = {};
        </script>
        
        <script src="~/Content/js/jquery.js"></script>
        <script src="~/Content/js/jquery-migrate.js"></script>
        <script src="~/Content/js/bootstrap.js"></script>
        <script src="~/Content/js/main.js"></script>
        
        @await RenderSectionAsync("Script")
        
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-JWD0V24RSP"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date()); gtag('config', 'G-JWD0V24RSP');
        </script>
    }
</body>
</html>